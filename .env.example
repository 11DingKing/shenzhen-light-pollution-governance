# Service configuration (all values are examples)
SHENZHEN_LIGHT_GOVERNANCE_SERVER_PORT=49820
SHENZHEN_LIGHT_GOVERNANCE_SERVER_READ_TIMEOUT=30s
SHENZHEN_LIGHT_GOVERNANCE_SERVER_WRITE_TIMEOUT=30s
SHENZHEN_LIGHT_GOVERNANCE_SERVER_SHUTDOWN_TIMEOUT=15s
SHENZHEN_LIGHT_GOVERNANCE_STORAGE_DATA_DIR=./data
SHENZHEN_LIGHT_GOVERNANCE_STORAGE_SHARD_MAX_SIZE=1048576
SHENZHEN_LIGHT_GOVERNANCE_STORAGE_SYNC_ON_WRITE=true
SHENZHEN_LIGHT_GOVERNANCE_SCHEDULER_ESCALATION_INTERVAL=30s
SHENZHEN_LIGHT_GOVERNANCE_SCHEDULER_RECONCILIATION_INTERVAL=5m
SHENZHEN_LIGHT_GOVERNANCE_SCHEDULER_REEVAL_INTERVAL=1m
SHENZHEN_LIGHT_GOVERNANCE_SCHEDULER_MAX_RETRIES=3
SHENZHEN_LIGHT_GOVERNANCE_SCHEDULER_BASE_BACKOFF=1s
SHENZHEN_LIGHT_GOVERNANCE_SCHEDULER_TASK_TIMEOUT=10s
SHENZHEN_LIGHT_GOVERNANCE_LOGGING_LEVEL=info
SHENZHEN_LIGHT_GOVERNANCE_LOGGING_FORMAT=json
SHENZHEN_LIGHT_GOVERNANCE_BUSINESS_DEFAULT_DEADLINE=72h
SHENZHEN_LIGHT_GOVERNANCE_BUSINESS_ESCALATION_DEADLINE_EXTENSION=48h
SHENZHEN_LIGHT_GOVERNANCE_BUSINESS_MAX_ESCALATION_LEVEL=3
